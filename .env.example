MONGODB_URI=your_mongodb_uri_here
DB_NAME=dams-wallet
JWT_SECRET=your_jwt_secret_here
PORT=8080

# =============================================================================
# AI INSIGHTS PROVIDER
# =============================================================================
# Pilih salah satu: "deepseek" atau "huggingface"
LLM_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# Mode 1: DeepSeek (API key wajib)
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ---------------------------------------------------------------------------
# Mode 2: HuggingFace Endpoint (API key optional, endpoint yang kamu kirim public)
# ---------------------------------------------------------------------------
HF_API_KEY=
LLM_BASE_URL=

# Model name. Jika dikosongkan, akan pakai default sesuai provider:
#   deepseek     -> deepseek-chat
#   huggingface  -> deepseek-ai/DeepSeek-V4-Flash-0731
LLM_MODEL=

LLM_TIMEOUT_SECONDS=60

# Sampling parameters, dipakai oleh HuggingFace provider.
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_REASONING_EFFORT=high
